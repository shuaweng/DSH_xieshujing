{
  "name": "@deepseek-ai/dsh-experimental-novel-repository",
  "description": "Experimental Novel Project repository capability seam and project vocabulary",
  "version": "0.1.2-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/novel-repository"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./asset-types": {
      "types": "./lib/types/asset-types.d.ts",
      "default": "./lib/types/asset-types.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.1.2-alpha.2",
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
