{
  "name": "@deepseek-ai/dsh-experimental-novel-asset-outline",
  "description": "Freeform book, volume, and chapter planning Assets for the experimental Novel Studio",
  "version": "0.1.1-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/novel-asset-outline"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-experimental-novel-workbench"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "files": ["lib/index.js", "lib/invariant.js", "lib/client.js", "lib/types/**/*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-experimental-novel-repository": "workspace:^",
    "@deepseek-ai/dsh-experimental-novel-repository-remote": "workspace:^",
    "@deepseek-ai/dsh-experimental-novel-workbench": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-experimental-novel-repository": "workspace:^",
    "@deepseek-ai/dsh-experimental-novel-repository-remote": "workspace:^",
    "@deepseek-ai/dsh-experimental-novel-workbench": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "react": "^18.2.0"
  }
}
